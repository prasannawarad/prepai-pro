# All keys here are server-side only — read by the api/ functions (and the Vite
# dev middleware). Never add a VITE_ prefix: Vite would inline the value into
# the public browser bundle.

# Required — Gemini powers research, mock interview, and scoring (api/gemini.js).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — per-IP rate limiting on the API proxy. Create a free Redis database
# at https://console.upstash.com (or via the Vercel Marketplace) and paste the
# REST credentials. Without these, a best-effort in-memory limiter is used.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional — voice answers in browsers without the Web Speech API (Firefox).
# Whisper transcription via Groq (free tier, key from https://console.groq.com),
# read by api/transcribe.js. Chrome/Edge/Safari dictate in-browser and don't
# need this.
# GROQ_API_KEY=your-groq-api-key-here
